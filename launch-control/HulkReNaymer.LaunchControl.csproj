<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Default: in-repo launch-control\LaunchControl.Standard (vendored from
    https://github.com/uberslaw/master-launch-control). No MLC clone, MLC_ROOT,
    or network is required.

    Optional override: set MlcRoot or MLC_ROOT to a master-launch-control repo
    that contains src\LaunchControl.Standard\LaunchControl.Standard.csproj.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>HulkReNaymer.LaunchControl</RootNamespace>
    <AssemblyName>HulkReNaymer.LaunchControl</AssemblyName>
    <ApplicationTitle>HulkReNaymer Launch Control</ApplicationTitle>
    <Product>HulkReNaymer Launch Control</Product>
    <Version>1.0.0</Version>
    <MlcStandardRel>src\LaunchControl.Standard\LaunchControl.Standard.csproj</MlcStandardRel>
    <MlcStandard Condition="'$(MlcRoot)' != '' and Exists('$(MlcRoot)\$(MlcStandardRel)')">$(MlcRoot)\$(MlcStandardRel)</MlcStandard>
    <MlcStandard Condition="'$(MlcStandard)' == '' and '$(MLC_ROOT)' != '' and Exists('$(MLC_ROOT)\$(MlcStandardRel)')">$(MLC_ROOT)\$(MlcStandardRel)</MlcStandard>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="LaunchControl.Standard\**" />
    <Page Remove="LaunchControl.Standard\**" />
    <EmbeddedResource Remove="LaunchControl.Standard\**" />
    <None Remove="LaunchControl.Standard\**" />
    <ApplicationDefinition Remove="LaunchControl.Standard\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="LaunchControl.Standard\LaunchControl.Standard.csproj" Condition="'$(MlcStandard)' == ''" />
    <ProjectReference Include="$(MlcStandard)" Condition="'$(MlcStandard)' != ''" />
  </ItemGroup>
</Project>

