<Window x:Class="LaunchControl.Standard.Host.LaunchControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LaunchControl.Standard"
        Title="Launch Control"
        Height="720" Width="1040"
        MinHeight="520" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBackgroundBrush}"
        FontFamily="{DynamicResource BodyFontFamily}"
        FontSize="{DynamicResource BodyFontSize}"
        local:ThemeRoles.Roles="PageBackgroundColor">
  <local:GlassBackground>
    <DockPanel>
      <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeBrush}" Padding="16,12"
              local:ThemeRoles.Roles="ChromeColor,OnChromeColor,HeaderMetaTextColor">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="TitleText" Text="Launch Control" FontWeight="SemiBold"
                       FontFamily="{DynamicResource HeadingFontFamily}"
                       FontSize="{DynamicResource HeadingFontSize}"
                       Foreground="{DynamicResource OnChromeBrush}"
                       local:ThemeChrome.Halo="True"
                       local:ThemeRoles.Roles="ChromeColor,OnChromeColor"/>
            <TextBlock x:Name="MetaText" Text="" Foreground="{DynamicResource HeaderMetaTextBrush}" Margin="0,4,0,0"
                       FontFamily="{DynamicResource BodyFontFamily}"
                       FontSize="{DynamicResource BodyFontSize}"
                       TextWrapping="Wrap"
                       local:ThemeChrome.Halo="True"
                       local:ThemeRoles.Roles="HeaderMetaTextColor,ChromeColor"/>
          </StackPanel>
          <Button Grid.Column="1" Content="Theme…" Style="{StaticResource SecondaryButtonStyle}"
                  VerticalAlignment="Center" Click="Theme_Click"
                  local:ThemeRoles.Roles="SecondaryButtonBackgroundColor,SecondaryButtonTextColor,CoolMutedColor,ButtonHoverColor"/>
        </Grid>
      </Border>

      <Border DockPanel.Dock="Bottom" Background="{DynamicResource FooterBackgroundBrush}" Padding="12,8"
              BorderBrush="{DynamicResource CoolMutedBrush}" BorderThickness="0,1,0,0"
              local:ThemeRoles.Roles="FooterBackgroundColor,FooterTextColor,CoolMutedColor">
        <TextBlock x:Name="FooterText" Foreground="{DynamicResource FooterTextBrush}"
                   FontFamily="{DynamicResource BodyFontFamily}"
                   FontSize="{DynamicResource BodyFontSize}"
                   Text="Closing this window does not stop the Windows service."
                   local:ThemeRoles.Roles="FooterBackgroundColor,FooterTextColor"/>
      </Border>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="14,12">
          <StackPanel>
            <TextBlock Text="Status" Foreground="{DynamicResource MetaTextBrush}"
                       local:ThemeRoles.Roles="MetaTextColor"/>
            <TextBlock x:Name="StatusLabel" Text="…" FontWeight="SemiBold" Margin="0,4,0,0"
                       FontFamily="{DynamicResource StatusFontFamily}"
                       FontSize="{DynamicResource HeadingFontSize}"
                       Foreground="{DynamicResource StatusUnknownBrush}"
                       local:ThemeChrome.Halo="True"
                       local:ThemeRoles.Roles="StatusRunningColor,SoftAccentColor,StrongWarmColor,StatusStoppedColor,ErrorColor,StatusUnknownColor"/>
            <TextBlock x:Name="PidLabel" Text="PID —" Margin="0,6,0,0"
                       Foreground="{DynamicResource BodyTextBrush}"
                       FontFamily="{DynamicResource DetailsFontFamily}"
                       FontSize="{DynamicResource DetailsFontSize}"
                       local:ThemeRoles.Roles="BodyTextColor"/>
            <TextBlock x:Name="AdminLabel" Text="" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource SoftAccentBrush}"
                       Visibility="Collapsed"
                       local:ThemeRoles.Roles="SoftAccentColor"/>

            <TextBlock x:Name="VenvLockHeader" Text="Python using this install"
                       Margin="0,14,0,4" Foreground="{DynamicResource MetaTextBrush}"
                       Visibility="Collapsed"
                       local:ThemeRoles.Roles="MetaTextColor"/>
            <TextBox x:Name="VenvLockBox" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" MaxHeight="130"
                     FontFamily="{DynamicResource DetailsFontFamily}"
                     FontSize="{DynamicResource DetailsFontSize}"
                     Foreground="{DynamicResource BodyTextBrush}"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     Visibility="Collapsed"
                     local:ThemeRoles.Roles="BodyTextColor"/>
            <Button x:Name="ShowVenvButton" Content="Show Python using this venv"
                    Margin="0,4,0,0" Visibility="Collapsed"
                    Style="{StaticResource SecondaryButtonStyle}" Click="ShowVenv_Click"
                    local:ThemeRoles.Roles="SecondaryButtonBackgroundColor,SecondaryButtonTextColor,CoolMutedColor,ButtonHoverColor"/>

            <StackPanel x:Name="ClassicServiceButtons">
              <Button x:Name="StartButton" Content="Start" Margin="0,16,0,6" Style="{StaticResource PrimaryButtonStyle}" Click="Start_Click"
                      local:ThemeRoles.Roles="PrimaryActionColor,OnPrimaryActionColor,ButtonHoverColor"/>
              <Button x:Name="StopButton" Content="Stop" Margin="0,0,0,6" Style="{StaticResource SecondaryButtonStyle}" Click="Stop_Click"
                      local:ThemeRoles.Roles="SecondaryButtonBackgroundColor,SecondaryButtonTextColor,CoolMutedColor,ButtonHoverColor"/>
              <Button x:Name="RestartButton" Content="Restart" Margin="0,0,0,6" Style="{StaticResource SecondaryButtonStyle}" Click="Restart_Click"
                      local:ThemeRoles.Roles="SecondaryButtonBackgroundColor,SecondaryButtonTextColor,CoolMutedColor,ButtonHoverColor"/>
            </StackPanel>
            <StackPanel x:Name="CompactServicesHost" Margin="0,12,0,0" Visibility="Collapsed"/>
            <Button x:Name="RefreshButton" Content="Refresh status" Margin="0,8,0,6" Style="{StaticResource SecondaryButtonStyle}" Click="Refresh_Click"
                    local:ThemeRoles.Roles="SecondaryButtonBackgroundColor,SecondaryButtonTextColor,CoolMutedColor,ButtonHoverColor"/>
            <Button x:Name="FollowLogsButton" Content="Follow logs: OFF" Margin="0,0,0,6"
                    Style="{StaticResource SecondaryButtonStyle}" Click="FollowLogs_Click"
                    local:ThemeRoles.Roles="SecondaryButtonBackgroundColor,SecondaryButtonTextColor,CoolMutedColor,ButtonHoverColor"/>

            <ItemsControl x:Name="ExtraButtons"/>

            <Button x:Name="BrowserButton" Content="Open in browser" Margin="0,12,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="Browser_Click"
                    local:ThemeRoles.Roles="SecondaryButtonBackgroundColor,SecondaryButtonTextColor,CoolMutedColor,ButtonHoverColor"/>
          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{DynamicResource ConsoleHeaderBackgroundBrush}" Padding="12,10">
            <Grid>
              <Border Background="{StaticResource GlassHighlightBrush}"
                      Opacity="{DynamicResource GlassOverlayOpacity}"
                      IsHitTestVisible="False"/>
              <StackPanel>
                <TextBlock x:Name="ServiceLine" Text="Service: —"
                           Foreground="{DynamicResource ConsoleTextBrush}"
                           local:ThemeChrome.Halo="True"/>
                <TextBlock x:Name="HealthLine" Text="Health: not checked" Margin="0,4,0,0"
                           Foreground="{DynamicResource ConsoleTextBrush}"
                           local:ThemeChrome.Halo="True"/>
                <TextBlock x:Name="ModeLine" Text="Mode: —" Margin="0,4,0,0"
                           Foreground="{DynamicResource ConsoleMetaTextBrush}"
                           local:ThemeChrome.Halo="True"/>
                <TextBlock Text="Events / logs (colored OK / WARN / ERROR / STEP · Follow logs for full file tail)"
                           Margin="0,6,0,0" Foreground="{DynamicResource ConsoleMetaTextBrush}" FontSize="11"/>
              </StackPanel>
            </Grid>
          </Border>
          <Grid Grid.Row="1" MinHeight="200">
            <Border Background="{DynamicResource ConsoleBackgroundBrush}"/>
            <Border Background="{StaticResource GlassHighlightBrush}"
                    Opacity="{DynamicResource GlassOverlayOpacity}"
                    IsHitTestVisible="False"/>
            <RichTextBox x:Name="LogBox"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         IsDocumentEnabled="True"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource ConsoleTextBrush}"
                         FontFamily="Consolas" FontSize="12"
                         Padding="10,8"/>
          </Grid>
        </Grid>
      </Grid>
    </DockPanel>
  </local:GlassBackground>
</Window>
