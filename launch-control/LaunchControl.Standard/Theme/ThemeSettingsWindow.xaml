<Window x:Class="LaunchControl.Standard.Theme.ThemeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LaunchControl.Standard"
        Title="Theme settings"
        Height="720" Width="1080"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI"
        FontSize="12"
        Background="#EEF0F5">
  <!-- Fixed local palette: Theme settings must stay readable regardless of live app theme. -->
  <Window.Resources>
    <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
    <SolidColorBrush x:Key="TsPageBg" Color="#EEF0F5"/>
    <SolidColorBrush x:Key="TsChrome" Color="#2c344c"/>
    <SolidColorBrush x:Key="TsOnChrome" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TsMuted" Color="#6B7285"/>
    <SolidColorBrush x:Key="TsAccent" Color="#f97c14"/>
    <SolidColorBrush x:Key="TsSoftAccent" Color="#fcac66"/>
    <SolidColorBrush x:Key="TsCard" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TsBorder" Color="#C8CDDC"/>
    <SolidColorBrush x:Key="TsFooter" Color="#F5F6FA"/>
    <SolidColorBrush x:Key="TsPrimary" Color="#f97c14"/>
    <SolidColorBrush x:Key="TsOnPrimary" Color="#2c344c"/>
    <SolidColorBrush x:Key="TsAttention" Color="#b2541d"/>
    <SolidColorBrush x:Key="TsText" Color="#2c344c"/>
    <SolidColorBrush x:Key="TsKeyText" Color="#956a58"/>
    <SolidColorBrush x:Key="TsHighlightBg" Color="#FFF4E8"/>
    <SolidColorBrush x:Key="TsInputBg" Color="#FFFFFF"/>

    <Style x:Key="TsPrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource TsPrimary}"/>
      <Setter Property="Foreground" Value="{StaticResource TsOnPrimary}"/>
      <Setter Property="BorderBrush" Value="{StaticResource TsPrimary}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource TsSoftAccent}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TsSoftAccent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TsSecondaryButton" TargetType="Button">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="{StaticResource TsText}"/>
      <Setter Property="BorderBrush" Value="{StaticResource TsBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F3F5FA"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TsSoftAccent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TsAttentionButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TsAttention}"/>
      <Setter Property="BorderBrush" Value="{StaticResource TsAttention}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F8E8DC"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TabControl">
      <Setter Property="Background" Value="{StaticResource TsPageBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource TsBorder}"/>
      <Setter Property="Padding" Value="0"/>
    </Style>

    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource TsText}"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Bd" Background="#E4E7EF" BorderBrush="{StaticResource TsBorder}"
                    BorderThickness="1,1,1,0" Margin="0,0,2,0" Padding="{TemplateBinding Padding}"
                    CornerRadius="3,3,0,0">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource TsCard}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F3F5FA"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource TsInputBg}"/>
      <Setter Property="Foreground" Value="{StaticResource TsText}"/>
      <Setter Property="BorderBrush" Value="{StaticResource TsBorder}"/>
      <Setter Property="CaretBrush" Value="{StaticResource TsText}"/>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="{StaticResource TsInputBg}"/>
      <Setter Property="Foreground" Value="{StaticResource TsText}"/>
      <Setter Property="BorderBrush" Value="{StaticResource TsBorder}"/>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TsText}"/>
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource TsChrome}" Padding="14,10">
      <StackPanel>
        <TextBlock Text="Theme settings" FontSize="18" FontWeight="SemiBold"
                   Foreground="{StaticResource TsOnChrome}"/>
        <TextBlock Text="Hover or click a color to outline matching controls on the main window. Click the main window to identify which colors a control uses."
                   Foreground="#B8BFD6" Margin="0,4,0,0" FontSize="12"
                   TextWrapping="Wrap"/>
        <TextBlock x:Name="SelectedRolesLabel" Margin="0,6,0,0" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource TsSoftAccent}" TextWrapping="Wrap"
                   Visibility="Collapsed"/>
        <TextBlock x:Name="TargetLabel" Margin="0,4,0,0" FontSize="12"
                   Foreground="#B8BFD6" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{StaticResource TsFooter}" Padding="12"
            BorderBrush="{StaticResource TsBorder}" BorderThickness="0,1,0,0">
      <DockPanel>
        <CheckBox x:Name="LivePreviewCheck" Content="Live preview" IsChecked="True"
                  VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="UndoButton" Content="Undo last change" Style="{StaticResource TsSecondaryButton}"
                  Margin="0,0,8,0" Padding="10,5" IsEnabled="False" Click="Undo_Click"
                  ToolTip="Restore the previous palette snapshot"/>
          <Button Content="Reset to defaults" Style="{StaticResource TsSecondaryButton}"
                  Margin="0,0,8,0" Padding="10,5" Click="Reset_Click"/>
          <Button Content="Apply" Style="{StaticResource TsPrimaryButton}"
                  Width="90" Margin="0,0,8,0" Click="Apply_Click"
                  ToolTip="Apply and save theme to disk"/>
          <Button Content="Close" Style="{StaticResource TsSecondaryButton}"
                  Width="90" Click="Close_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <TabControl x:Name="ThemeTabs" Margin="10,8,10,4" Padding="0">
      <TabItem Header="Colors">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="8,10,8,4" MaxWidth="260" HorizontalAlignment="Left">
            <TextBox x:Name="ColorFilterBox" Padding="8,5" VerticalContentAlignment="Center"
                     TextChanged="ColorFilter_TextChanged"/>
            <TextBlock x:Name="ColorFilterPlaceholder" Text="Filter…" IsHitTestVisible="False"
                       Margin="10,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource TsMuted}"/>
          </Grid>

          <ScrollViewer x:Name="ColorScroll" VerticalScrollBarVisibility="Auto" Padding="8,6,8,4">
            <ItemsControl x:Name="CategoryList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TsMuted}" Margin="2,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="0,0,8,8" Padding="10,7"
                                  Background="{Binding CategoryTint}"
                                  BorderThickness="2" CornerRadius="3"
                                  MouseEnter="ColorRow_MouseEnter"
                                  MouseLeave="ColorRow_MouseLeave"
                                  PreviewMouseLeftButtonDown="ColorRow_PreviewMouseLeftButtonDown">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource TsBorder}"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource TsAccent}"/>
                                    <Setter Property="Background" Value="{StaticResource TsHighlightBg}"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Purpose}" FontWeight="SemiBold"
                                           Foreground="{StaticResource TsText}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Key}" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{StaticResource TsKeyText}"/>
                              </StackPanel>
                              <Border Grid.Column="1" Width="28" Height="28" Margin="0,0,8,0"
                                      BorderBrush="{StaticResource TsBorder}" BorderThickness="1"
                                      CornerRadius="2" VerticalAlignment="Center" Cursor="Hand"
                                      Background="{Binding SwatchBrush}"
                                      Tag="ThemeSwatch"
                                      ToolTip="Pick color"
                                      MouseLeftButtonUp="PickColor_Click"/>
                              <TextBox Grid.Column="2" Text="{Binding HexText, UpdateSourceTrigger=PropertyChanged}"
                                       VerticalAlignment="Center" Padding="6,4"
                                       FontFamily="Consolas" FontSize="12"/>
                              <Button Grid.Column="3" Content="…" Width="28" Height="28" Margin="6,0,0,0"
                                      Padding="0" VerticalAlignment="Center"
                                      Style="{StaticResource TsSecondaryButton}"
                                      ToolTip="Pick color"
                                      Click="PickColor_Click"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <TabItem Header="Font">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="8,12,8,0">
            <TextBlock Text="Each role has its own font family and size. Changes follow Live preview, same as colors. Apply saves them with the theme."
                       Foreground="{StaticResource TsMuted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <Button Content="Reset all fonts" Style="{StaticResource TsSecondaryButton}" Padding="10,5"
                    HorizontalAlignment="Left" Click="ResetAllFonts_Click"
                    ToolTip="Restore every font role to Segoe UI and the built-in sizes"/>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,10,8,8">
            <ItemsControl x:Name="FontRoleList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,10" Padding="12,10" Background="{StaticResource TsCard}"
                          BorderBrush="{StaticResource TsBorder}" BorderThickness="1" CornerRadius="3">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,8">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                   Foreground="{StaticResource TsText}"/>
                        <TextBlock Text="{Binding Purpose}" Margin="0,2,0,0"
                                   Foreground="{StaticResource TsMuted}" TextWrapping="Wrap"/>
                      </StackPanel>
                      <Button Grid.Row="0" Grid.Column="1" Content="Reset" Padding="10,4"
                              Style="{StaticResource TsSecondaryButton}" VerticalAlignment="Top"
                              Click="ResetFontRole_Click" Tag="{Binding}"
                              ToolTip="Reset this role to its default font and size"/>
                      <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Families}"
                                  SelectedItem="{Binding Family, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" IsTextSearchEnabled="True"
                                  MaxDropDownHeight="320"
                                  Padding="6,4" VerticalAlignment="Center"
                                  ToolTip="Installed Windows fonts"/>
                        <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Padding="10,4"
                                Style="{StaticResource TsSecondaryButton}"
                                Click="BrowseFont_Click" Tag="{Binding}"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                          <Button Content="−" Width="32" Height="28" Padding="0"
                                  Style="{StaticResource TsSecondaryButton}"
                                  Click="FontSizeMinus_Click" Tag="{Binding}"
                                  ToolTip="Decrease size by 1 pt"/>
                          <TextBlock Text="{Binding SizeLabel}" MinWidth="56" Margin="8,0"
                                     VerticalAlignment="Center" HorizontalAlignment="Center"
                                     Foreground="{StaticResource TsText}"
                                     FontFamily="Consolas"/>
                          <Button Content="+" Width="32" Height="28" Padding="0"
                                  Style="{StaticResource TsSecondaryButton}"
                                  Click="FontSizePlus_Click" Tag="{Binding}"
                                  ToolTip="Increase size by 1 pt"/>
                        </StackPanel>
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <TabItem Header="Going glass">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
          <StackPanel>
            <TextBlock Text="Going glass — background photo for this Launch Control only"
                       Foreground="{StaticResource TsText}" FontWeight="SemiBold" FontSize="14"
                       TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBlock Text="Turn it on, choose a png/jpg, set intensity, then Apply. Master Launch Control: use Theme this LC… on an app card to set glass for that product (not MLC chrome)."
                       Foreground="{StaticResource TsMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <CheckBox x:Name="GlassEnabledCheck" Content="Going glass"
                      Foreground="{StaticResource TsText}" FontWeight="SemiBold"
                      Checked="GlassEnabled_Changed" Unchecked="GlassEnabled_Changed"/>
            <TextBlock Text="Frosts the whole window: sidebar, console/log pane, and buttons. Log text stays light on a light glass tint. Start keeps an orange tint, not a solid fill."
                       Foreground="{StaticResource TsMuted}" TextWrapping="Wrap" Margin="0,6,0,12"/>

            <TextBlock Text="Background image" FontWeight="SemiBold" Foreground="{StaticResource TsText}"/>
            <TextBlock x:Name="GlassImagePathLabel" Text="No image selected"
                       Foreground="{StaticResource TsKeyText}" TextWrapping="Wrap" Margin="0,4,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
              <Button Content="Choose background image…" Style="{StaticResource TsPrimaryButton}"
                      Click="ChooseGlassImage_Click"/>
              <Button Content="Clear image" Style="{StaticResource TsSecondaryButton}" Margin="8,0,0,0"
                      Click="ClearGlassImage_Click"/>
            </StackPanel>

            <TextBlock Text="Glass intensity (more frost ← → more photo)" Foreground="{StaticResource TsText}"/>
            <Slider x:Name="GlassIntensitySlider" Minimum="0" Maximum="1" Value="0.65"
                    TickFrequency="0.05" IsSnapToTickEnabled="False"
                    Margin="0,6,0,4" ValueChanged="GlassSlider_Changed"/>
            <TextBlock x:Name="GlassIntensityLabel" Text="0.65" Foreground="{StaticResource TsMuted}" Margin="0,0,0,12"/>

            <TextBlock Text="Blur radius" Foreground="{StaticResource TsText}"/>
            <Slider x:Name="GlassBlurSlider" Minimum="0" Maximum="50" Value="18"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    Margin="0,6,0,4" ValueChanged="GlassSlider_Changed"/>
            <TextBlock x:Name="GlassBlurLabel" Text="18" Foreground="{StaticResource TsMuted}" Margin="0,0,0,12"/>

            <CheckBox x:Name="GlassHaloCheck" Content="Text halo / glow (helps headings on busy photos)"
                      Foreground="{StaticResource TsText}" IsChecked="True"
                      Checked="GlassHalo_Changed" Unchecked="GlassHalo_Changed"/>

            <Button Content="Suggest contrasting colours" Style="{StaticResource TsSecondaryButton}"
                    HorizontalAlignment="Left" Margin="0,16,0,8"
                    Click="SuggestGlassColors_Click"
                    ToolTip="When glass is on, invert text/borders that would fail contrast. You can still edit colours on the Colors tab."/>
            <TextBlock Text="Suggestions write into the colour fields (live preview follows). Apply saves theme.json including the image path (copied into AppData)."
                       Foreground="{StaticResource TsMuted}" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Slots">
        <StackPanel Margin="8,12,8,8">
          <TextBlock Text="Select a slot, then Load or Save. Empty slots show a dashed strip."
                     Foreground="{StaticResource TsMuted}" FontSize="11" Margin="0,0,0,10"
                     TextWrapping="Wrap"/>

          <ItemsControl x:Name="SlotList" Margin="0,0,0,8">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,8,8" Padding="6" CornerRadius="3" Cursor="Hand"
                        Background="{StaticResource TsCard}"
                        BorderThickness="2"
                        MouseLeftButtonUp="Slot_Click"
                        Tag="{Binding}">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="BorderBrush" Value="{StaticResource TsBorder}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                          <Setter Property="BorderBrush" Value="{StaticResource TsAccent}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid Height="28">
                    <Border BorderBrush="{StaticResource TsBorder}" BorderThickness="1"
                            CornerRadius="2"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                      <Border.Background>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
                          <DrawingBrush.Drawing>
                            <GeometryDrawing Geometry="M0,0 L8,8 M8,0 L0,8">
                              <GeometryDrawing.Pen>
                                <Pen Brush="#C8CDDC" Thickness="1"/>
                              </GeometryDrawing.Pen>
                            </GeometryDrawing>
                          </DrawingBrush.Drawing>
                        </DrawingBrush>
                      </Border.Background>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Swatches}"
                                  Visibility="{Binding HasColors, Converter={StaticResource BoolToVis}}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{Binding}" Margin="0,0,1,0"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Button Content="Load" Style="{StaticResource TsSecondaryButton}" Padding="10,5"
                    Margin="0,0,8,0" Click="LoadSlot_Click"
                    ToolTip="Load selected slot into the editor and apply live"/>
            <Button Content="Save to slot" Style="{StaticResource TsPrimaryButton}" Padding="10,5"
                    Margin="0,0,8,0" Click="SaveSlot_Click"
                    ToolTip="Store current colors into the selected slot"/>
            <Button Content="Clear slot" Style="{StaticResource TsAttentionButton}" Padding="10,5"
                    Click="ClearSlot_Click"/>
          </StackPanel>
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
