<Window x:Class="HulkReNaymer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HulkReNaymer"
        Height="900" Width="1440"
        MinHeight="700" MinWidth="1100"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource Bg2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Image Source="pack://application:,,,/Assets/hulk.png" Width="36" Height="36" Margin="0,0,10,0"/>
          <StackPanel>
            <TextBlock Text="HulkReNaymer" FontFamily="{StaticResource Bangers}" FontSize="32" Foreground="{StaticResource GammaBrush}"/>
            <TextBlock Text="Bulk rename. Preview first. Smash after." Foreground="{StaticResource MutedBrush}" FontSize="11"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="Load demo files" Style="{StaticResource GhostButton}" Command="{Binding SeedDemoCommand}"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Background="{StaticResource Bg2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,8">
      <DockPanel>
        <Button Content="↑" Style="{StaticResource GhostButton}" Command="{Binding GoUpCommand}" DockPanel.Dock="Left" Width="36"/>
        <Button Content="Open" Style="{StaticResource GhostButton}" Click="BrowseFolder" DockPanel.Dock="Right"/>
        <CheckBox Content="Subfolders" IsChecked="{Binding Recurse}" Margin="10,0,0,0" DockPanel.Dock="Right" Checked="OnScanChanged" Unchecked="OnScanChanged"/>
        <CheckBox Content="Files" IsChecked="{Binding IncludeFiles}" DockPanel.Dock="Right" Checked="OnScanChanged" Unchecked="OnScanChanged"/>
        <CheckBox Content="Folders" IsChecked="{Binding IncludeFolders}" DockPanel.Dock="Right" Checked="OnScanChanged" Unchecked="OnScanChanged"/>
        <TextBox x:Name="WildcardBox" Text="{Binding Wildcard, UpdateSourceTrigger=PropertyChanged}" Width="90" DockPanel.Dock="Right" Margin="8,0" ToolTip="Wildcard filter" TextChanged="OnScanChanged"/>
        <TextBox x:Name="PathBox" Text="{Binding CurrentPath, UpdateSourceTrigger=PropertyChanged}" Margin="8,0" KeyDown="PathKeyDown"/>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{StaticResource Bg2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Stats}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <ComboBox x:Name="PresetBox" Width="180" ItemsSource="{Binding Presets}" SelectionChanged="PresetChanged"/>
          <ComboBox Width="140" ItemsSource="{Binding Favorites}" SelectionChanged="FavoriteChanged"/>
          <TextBox Width="120" Text="{Binding FavoriteName, UpdateSourceTrigger=PropertyChanged}" Margin="4,0"/>
          <Button Content="Save" Style="{StaticResource GhostButton}" Command="{Binding SaveFavoriteCommand}"/>
          <Button Content="Log" Style="{StaticResource GhostButton}" Command="{Binding ShowLogCommand}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Content="Reset rules" Style="{StaticResource GhostButton}" Click="ResetClicked"/>
          <Button Content="Undo" Style="{StaticResource GhostButton}" Command="{Binding UndoCommand}"/>
          <Button Content="Smash Rename" Style="{StaticResource SmashButton}" Command="{Binding RenameCommand}" IsEnabled="{Binding CanRename}"/>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer DockPanel.Dock="Bottom" MaxHeight="280" VerticalScrollBarVisibility="Auto" Background="{StaticResource Bg2Brush}">
      <UniformGrid x:Name="RulesHost" Columns="4" Margin="4">
        <Border Style="{StaticResource RuleCard}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource Badge}"><TextBlock Text="1" Foreground="#10210F" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
              <TextBlock Text="Regular expression" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <CheckBox x:Name="RegexOn" Content="Enable"/>
            <TextBox x:Name="RegexPattern" Tag="hint" ToolTip="Match pattern"/>
            <TextBox x:Name="RegexReplace" ToolTip="Replace with (\1 or $1)"/>
            <ComboBox x:Name="RegexApplyTo" SelectedIndex="0">
              <ComboBoxItem Content="Name" Tag="name"/>
              <ComboBoxItem Content="Extension" Tag="ext"/>
              <ComboBoxItem Content="Both" Tag="both"/>
              <ComboBoxItem Content="Name + ext" Tag="full"/>
            </ComboBox>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource RuleCard}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource Badge}"><TextBlock Text="2" Foreground="#10210F" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
              <TextBlock Text="Name / extension" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <CheckBox x:Name="NameOn" Content="Enable"/>
            <ComboBox x:Name="NameMode" SelectedIndex="0">
              <ComboBoxItem Content="Keep name" Tag="keep"/>
              <ComboBoxItem Content="Fixed name" Tag="fixed"/>
              <ComboBoxItem Content="Remove name" Tag="remove"/>
            </ComboBox>
            <TextBox x:Name="NameFixed" ToolTip="New name / tokens"/>
            <ComboBox x:Name="ExtMode" SelectedIndex="0">
              <ComboBoxItem Content="Keep ext" Tag="keep"/>
              <ComboBoxItem Content="Fixed ext" Tag="fixed"/>
              <ComboBoxItem Content="Remove ext" Tag="remove"/>
              <ComboBoxItem Content="ext lower" Tag="lower"/>
              <ComboBoxItem Content="EXT UPPER" Tag="upper"/>
            </ComboBox>
            <TextBox x:Name="ExtFixed"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource RuleCard}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource Badge}"><TextBlock Text="3" Foreground="#10210F" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
              <TextBlock Text="Find / replace" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <CheckBox x:Name="ReplaceOn" Content="Enable"/>
            <TextBox x:Name="FindBox" ToolTip="Find"/>
            <TextBox x:Name="ReplaceWithBox" ToolTip="Replace with (blank = delete)"/>
            <CheckBox x:Name="ReplaceAllBox" Content="All" IsChecked="True"/>
            <CheckBox x:Name="ReplaceCaseBox" Content="Match case" IsChecked="True"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource RuleCard}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource Badge}"><TextBlock Text="4" Foreground="#10210F" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
              <TextBlock Text="Case" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <ComboBox x:Name="CaseModeBox" SelectedIndex="0">
              <ComboBoxItem Content="No change" Tag="same"/>
              <ComboBoxItem Content="lower case" Tag="lower"/>
              <ComboBoxItem Content="UPPER CASE" Tag="upper"/>
              <ComboBoxItem Content="Title Case" Tag="title"/>
              <ComboBoxItem Content="Sentence case" Tag="sentence"/>
              <ComboBoxItem Content="tOGGLE" Tag="toggle"/>
            </ComboBox>
            <ComboBox x:Name="CaseApplyToBox" SelectedIndex="0">
              <ComboBoxItem Content="Name" Tag="name"/>
              <ComboBoxItem Content="Extension" Tag="ext"/>
              <ComboBoxItem Content="Both" Tag="both"/>
            </ComboBox>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource RuleCard}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource Badge}"><TextBlock Text="5" Foreground="#10210F" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
              <TextBlock Text="Remove" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <CheckBox x:Name="RemoveOn" Content="Enable"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="First" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBox x:Name="RemoveFirst" Width="50" Text="0"/>
              <TextBlock Text="Last" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,6,0"/>
              <TextBox x:Name="RemoveLast" Width="50" Text="0"/>
            </StackPanel>
            <TextBox x:Name="RemoveChars" ToolTip="Strip these characters"/>
            <CheckBox x:Name="RemoveDigits" Content="Digits"/>
            <CheckBox x:Name="RemoveSymbols" Content="Symbols"/>
            <CheckBox x:Name="CollapseSpaces" Content="Squeeze spaces"/>
            <CheckBox x:Name="RemoveTrim" Content="Trim"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource RuleCard}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource Badge}"><TextBlock Text="6" Foreground="#10210F" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
              <TextBlock Text="Move / copy chars" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <CheckBox x:Name="MoveOn" Content="Enable"/>
            <TextBox x:Name="MoveFrom" ToolTip="From" Text="0"/>
            <TextBox x:Name="MoveCount" ToolTip="Count" Text="0"/>
            <TextBox x:Name="MoveTo" ToolTip="To" Text="0"/>
            <CheckBox x:Name="MoveCopy" Content="Copy instead of move"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource RuleCard}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource Badge}"><TextBlock Text="7" Foreground="#10210F" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
              <TextBlock Text="Add text" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <CheckBox x:Name="AddOn" Content="Enable"/>
            <TextBox x:Name="PrefixBox" ToolTip="Prefix  e.g. PROJECT123_"/>
            <TextBox x:Name="SuffixBox" ToolTip="Suffix  e.g. _Approved"/>
            <DockPanel>
              <TextBox x:Name="InsertAtBox" DockPanel.Dock="Right" Width="50" Text="0" ToolTip="At"/>
              <TextBox x:Name="InsertBox" ToolTip="Insert text" Margin="0,0,6,0"/>
            </DockPanel>
            <TextBlock Text="Tokens: {name} {folder} {n} {date} {exif.date} {id3.artist}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource RuleCard}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource Badge}"><TextBlock Text="8" Foreground="#10210F" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
              <TextBlock Text="Parent folder" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <CheckBox x:Name="FolderOn" Content="Enable"/>
            <ComboBox x:Name="FolderModeBox" SelectedIndex="0">
              <ComboBoxItem Content="Prefix" Tag="prefix"/>
              <ComboBoxItem Content="Suffix" Tag="suffix"/>
            </ComboBox>
            <TextBox x:Name="FolderSep" Text="_"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource RuleCard}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource Badge}"><TextBlock Text="9" Foreground="#10210F" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
              <TextBlock Text="Numbering" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <CheckBox x:Name="NumberOn" Content="Enable"/>
            <StackPanel Orientation="Horizontal">
              <TextBox x:Name="NumberStart" Width="50" Text="1" ToolTip="Start" Margin="0,0,4,0"/>
              <TextBox x:Name="NumberStep" Width="50" Text="1" ToolTip="Step" Margin="0,0,4,0"/>
              <TextBox x:Name="NumberPad" Width="50" Text="3" ToolTip="Pad"/>
            </StackPanel>
            <ComboBox x:Name="NumberPos" SelectedIndex="0">
              <ComboBoxItem Content="Suffix" Tag="suffix"/>
              <ComboBoxItem Content="Prefix" Tag="prefix"/>
              <ComboBoxItem Content="Insert" Tag="insert"/>
              <ComboBoxItem Content="Replace name" Tag="replace"/>
            </ComboBox>
            <TextBox x:Name="NumberSep" Text="_"/>
            <CheckBox x:Name="NumberReset" Content="Reset in each folder"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource RuleCard}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource Badge}"><TextBlock Text="10" Foreground="#10210F" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
              <TextBlock Text="Date / time" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <CheckBox x:Name="DateOn" Content="Enable"/>
            <ComboBox x:Name="DateSourceBox" SelectedIndex="0">
              <ComboBoxItem Content="Modified" Tag="modified"/>
              <ComboBoxItem Content="Created" Tag="created"/>
              <ComboBoxItem Content="Accessed" Tag="accessed"/>
              <ComboBoxItem Content="Now" Tag="now"/>
              <ComboBoxItem Content="Photo EXIF" Tag="exif"/>
            </ComboBox>
            <TextBox x:Name="DateFormatBox" Text="yyyy-MM-dd"/>
            <ComboBox x:Name="DatePosBox" SelectedIndex="0">
              <ComboBoxItem Content="Prefix" Tag="prefix"/>
              <ComboBoxItem Content="Suffix" Tag="suffix"/>
            </ComboBox>
            <TextBox x:Name="DateSep" Text="_"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource RuleCard}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource Badge}"><TextBlock Text="11" Foreground="#10210F" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
              <TextBlock Text="JavaScript" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <CheckBox x:Name="JsOn" Content="Enable"/>
            <TextBox x:Name="JsBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                     ToolTip="Assign newName. Vars: name, ext, index, folder, size, exif, id3"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource RuleCard}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource Badge}"><TextBlock Text="12" Foreground="#10210F" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
              <TextBlock Text="Name list" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBox x:Name="MappingBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="11"/>
            <Button Content="Import list" Style="{StaticResource GhostButton}" Click="ImportMappingClicked" HorizontalAlignment="Left"/>
            <CheckBox x:Name="MappingExclusive" Content="List replaces other rules" IsChecked="True"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource RuleCard}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource Badge}"><TextBlock Text="13" Foreground="#10210F" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
              <TextBlock Text="Filters" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBox x:Name="NameRegexBox" ToolTip="Name regex filter" Text="{Binding NameRegex, UpdateSourceTrigger=PropertyChanged}"/>
            <CheckBox Content="Hidden files" IsChecked="{Binding IncludeHidden}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource RuleCard}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource Badge}"><TextBlock Text="14" Foreground="#10210F" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
              <TextBlock Text="Copy / move" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <ComboBox x:Name="OperationBox" SelectedIndex="0">
              <ComboBoxItem Content="Rename in place" Tag="rename"/>
              <ComboBoxItem Content="Copy to folder" Tag="copy"/>
              <ComboBoxItem Content="Move to folder" Tag="move"/>
            </ComboBox>
            <TextBox x:Name="DestDirBox" ToolTip="Destination folder"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource RuleCard}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource Badge}"><TextBlock Text="15" Foreground="#10210F" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
              <TextBlock Text="Timestamps" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <CheckBox x:Name="SetTimestamps" Content="Set times"/>
            <TextBox x:Name="TsModified" ToolTip="Modified ISO datetime"/>
            <TextBox x:Name="TsAccessed" ToolTip="Accessed ISO datetime"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource RuleCard}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource Badge}"><TextBlock Text="16" Foreground="#10210F" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border>
              <TextBlock Text="Attributes" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <CheckBox x:Name="SetReadonly" Content="Change read-only"/>
            <CheckBox x:Name="ReadonlyValue" Content="Make read-only"/>
            <CheckBox x:Name="SetHidden" Content="Change hidden"/>
            <CheckBox x:Name="HiddenValue" Content="Make hidden"/>
            <CheckBox x:Name="WindowsSafe" Content="Windows-safe names" IsChecked="True"/>
          </StackPanel>
        </Border>
      </UniformGrid>
    </ScrollViewer>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Background="#101C14" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="8">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="PLACES" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="4,4,4,6"/>
          <ItemsControl ItemsSource="{Binding Places}" DockPanel.Dock="Top">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Label}" Tag="{Binding Path}" Style="{StaticResource PlaceButton}" Click="PlaceClicked"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock DockPanel.Dock="Top" Text="FOLDERS" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="4,12,4,6"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Folders}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Content="{Binding Label}" Tag="{Binding Path}" Style="{StaticResource PlaceButton}" Click="PlaceClicked"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <DataGrid Grid.Column="1" ItemsSource="{Binding Files}" HeadersVisibility="Column"
                IsReadOnly="False" CanUserDeleteRows="False" CanUserResizeRows="False">
        <DataGrid.Columns>
          <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
          <DataGridTextColumn Header="Name" Binding="{Binding OldName}" Width="*" IsReadOnly="True"/>
          <DataGridTextColumn Header="New name" Binding="{Binding NewName}" Width="*" IsReadOnly="True">
            <DataGridTextColumn.ElementStyle>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Item.NewNameBrush}"/>
              </Style>
            </DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Ext" Binding="{Binding Ext}" Width="70" IsReadOnly="True"/>
          <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="80" IsReadOnly="True"/>
          <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="150" IsReadOnly="True"/>
          <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="110" IsReadOnly="True"/>
          <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" IsReadOnly="True"/>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </DockPanel>
</Window>
