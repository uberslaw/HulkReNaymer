<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationTitle>HulkReNaymer</ApplicationTitle>
    <AssemblyName>HulkReNaymer</AssemblyName>
    <RootNamespace>HulkReNaymer.App</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets\hulk.ico</ApplicationIcon>
    <Product>HulkReNaymer</Product>
    <Description>Windows bulk rename utility with live preview.</Description>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>HulkReNaymer</Company>
    <Authors>HulkReNaymer contributors</Authors>
    <Copyright>Copyright (c) 2026 HulkReNaymer contributors</Copyright>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HulkReNaymer.Core\HulkReNaymer.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Bangers-Regular.ttf" />
    <Resource Include="Assets\hulk.png" />
  </ItemGroup>
</Project>
